DOXYFILE_ENCODING = UTF-8
PROJECT_NAME = UnrealVoxta
PROJECT_NUMBER = 0.1.1
OUTPUT_DIRECTORY = ./docs/unrealvoxta

USE_MDFILE_AS_MAINPAGE = doxygen.md
INPUT_ENCODING = UTF-8
INPUT = ./UnrealVoxta/Source
INPUT += ./UnrealVoxta/README.md

EXCLUDE = ./UnrealVoxta/Source/VoxtaAudioUtility/Public/RuntimeAudioImporter
EXCLUDE += ./UnrealVoxta/Source/VoxtaAudioUtility/Private/RuntimeAudioImporter
HTML_INDEX_NUM_ENTRIES = 0

RECURSIVE = YES
EXTRACT_ALL = YES
FULL_PATH_NAMES = NO
FILE_PATTERNS = *.cpp  *.h  *.Build.cs  *.md
EXCLUDE_PATTERNS = */.git/*

JAVADOC_AUTOBRIEF = YES
MARKDOWN_SUPPORT = YES
GENERATE_XML = NO
USE_MATHJAX=YES
GENERATE_LATEX = NO
HTML_OUTPUT = ../../docs/